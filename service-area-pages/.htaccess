RewriteEngine On
Options -Indexes -MultiViews
DirectorySlash Off

# Serve the landing page for the physical directory without exposing its index.
DirectoryIndex index.html
RewriteCond %{THE_REQUEST} \s/+(.*/)?service-area/(?:index\.html)?[?\s] [NC]
RewriteRule ^(?:index\.html)?$ /%1service-area [R=301,L,NE]

# =====================================================
# KOLABAGAN
# =====================================================

# Legacy URL variants -> canonical clean URL
RewriteCond %{THE_REQUEST} \s/+(.*/)?service-area/curtain-shop-in-kolabagan(?:\.html)?/?[?\s] [NC]
RewriteRule ^curtain-shop-in-kolabagan(?:\.html)?/?$ /%1service-area/kolabagan [R=301,L,NE]

# Clean URL -> actual HTML file internally
RewriteRule ^kolabagan/?$ curtain-shop-in-kolabagan.html [L]
